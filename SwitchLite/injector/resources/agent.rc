// Windows resource file for SwitchLite Injector
// Embeds version info into the PE executable.
// agent.jar is embedded at build time via linker.

#include <windows.h>

// Icon placeholder (future)
// IDI_ICON1 ICON "switchlite.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SwitchLite"
            VALUE "FileDescription", "SwitchLite Injector"
            VALUE "FileVersion", "0.1.0-alpha"
            VALUE "ProductName", "SwitchLite"
            VALUE "ProductVersion", "0.1.0-alpha"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
